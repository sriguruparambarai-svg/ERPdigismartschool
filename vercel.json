    }
  ],
  "functions": {
    "api/report-data.js": {
      "maxDuration": 60
    },
    "api/social-posts.js": {
      "maxDuration": 60
    },
    "api/social-meta.js": {
      "maxDuration": 60
    },
    "api/festival-wishes.js": {
      "maxDuration": 300
    },
    "api/daily-posters.js": {
      "maxDuration": 300
    },
    "api/voice-notes.js": {
      "maxDuration": 60
    }
  }
