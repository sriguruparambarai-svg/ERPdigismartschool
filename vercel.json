    },
    {
      "path": "/api/morning-job",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/push",
      "schedule": "0 5,7 * * 1-6"
    },
    {
      "path": "/api/festival-wishes",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/daily-posters",
      "schedule": "30 0 * * 1"
    },
    {
      "path": "/api/daily-posters",
      "schedule": "30 1 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/p/:alias",
      "destination": "/parent/index.html?alias=:alias"
    },
    {
      "source": "/ark",
